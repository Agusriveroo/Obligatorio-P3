@model WebApp.Models.AltaEnvioViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Alta de envio</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
          
                <label asp-for="Dto.EmailCliente" class="control-label"></label>
                <input asp-for="Dto.EmailCliente" class="form-control" />
                <span asp-validation-for="Dto.EmailCliente" class="text-danger"></span>
            </div>

            <div class="form-group">
           
                <label asp-for="Dto.PesoPaquete" class="control-label"></label>
                <input asp-for="Dto.PesoPaquete" class="form-control" />
                <span asp-validation-for="Dto.PesoPaquete" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Tipo de envio</label>
                <select  asp-items="Model.TiposEnvios" asp-for="@Model.Dto.TipoEnvio" class="form-control">
                    
                </select>
            </div>

           
           <div id="opcionesComun">
                <div class="form-group">
                    <label>Agencias de retiro</label>
                    <select asp-items="Model.Agencias" asp-for="@Model.Dto.AgenciaRetiroId" class="form-control">
                        <option value="">Seleccione una agencia...</option>
                    </select>
                </div>
           </div>

            <div id="opcionesUrgente">
                <div class="form-group">
                 
                    <label asp-for="Dto.DireccionPostal" class="control-label"></label>
                    <input asp-for="Dto.DireccionPostal" class="form-control" />
                    <span asp-validation-for="Dto.DireccionPostal" class="text-danger"></span>
                </div>

            </div>


            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@ViewBag.msg


<div>
    <a asp-action="Index">Back to List</a>
</div>


<script src="~/js/Envio/Create.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

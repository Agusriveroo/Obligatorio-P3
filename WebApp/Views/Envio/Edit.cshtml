@model Libreria.DTOs.DTOs.DTOsEnvio.DTOListarEnvio

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>DTOListarEnvio</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div hidden class="form-group">
                <label asp-for="IdEnvio" class="control-label"></label>
                <input asp-for="IdEnvio" class="form-control" />
                <span asp-validation-for="IdEnvio" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="EmailCliente" class="control-label"></label>
                <input asp-for="EmailCliente" class="form-control" readonly />
                <input type="hidden" asp-for="EmailCliente" />
                <span asp-validation-for="EmailCliente" class="text-danger"></span>
            </div>



            <div class="form-group">
                <label asp-for="PesoPaquete" class="control-label"></label>
                <input asp-for="PesoPaquete" class="form-control" readonly/>
                <span asp-validation-for="PesoPaquete" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FechaFinalizacion" class="control-label"></label>
                <input asp-for="FechaFinalizacion" class="form-control" readonly />
                <span asp-validation-for="FechaFinalizacion" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input type="checkbox" class="form-check-input" id="Finalizar" name="Estado" value="@ViewBag.FinalizadoValor" />
                <label class="form-check-label" for="Finalizar">Marcar para finalizar</label>
            </div>

           
           
            <div class="form-group">
                <input type="submit" value="Finalizar envio" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@ViewBag.Error

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

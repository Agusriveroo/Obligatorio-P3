@model List<Libreria.DTOs.DTOs.DTOsDetalleEnvio.DTODetalle>

@{
    ViewData["Title"] = "Detalle";
}

<h1>Detalle</h1>

<h4>Lista de Detalles</h4>
<hr />

@foreach (var detalle in Model)
{
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="Detalle" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" name="Id" value="@detalle.Id" />
                <input type="hidden" name="LogueadoId" value="@detalle.LogueadoId" />

                <div class="form-group">
                    <label for="EnvioId">Envio ID</label>
                    <input type="text" name="EnvioId" class="form-control" value="@detalle.EnvioId" readonly />
                </div>

                <div class="form-group">
                    <label for="Comentario">Comentario</label>
                    <input type="text" name="Comentario" class="form-control" value="@detalle.Comentario" />
                </div>

                <div class="form-group">
                    <label for="Fecha">Fecha</label>
                    <input type="text" name="Fecha" class="form-control" value="@detalle.Fecha.ToString("yyyy-MM-dd HH:mm")" readonly />
                </div>

                <div class="form-group mt-2">
                    <input type="submit" value="Guardar Comentario" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
}


<div>
    <a asp-action="Index">Volver a la lista</a>
</div>
